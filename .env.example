# Canonical site URL (no trailing slash). Used for JSON-LD, canonical link, and og:url at runtime.
# VITE_SITE_URL=https://your-production-domain.com

# ---------------------------------------------------------------------------
# EmailJS (contact form)
# ---------------------------------------------------------------------------
# Every VITE_* value is inlined into the public JavaScript bundle. Only the
# EmailJS PUBLIC key belongs here.
#
# Never add the EmailJS private key, SMTP passwords or any other secret to this
# file or to any VITE_* variable. The private key is for server-side REST calls
# only and would be readable by anyone who opens the site.
#
# Leave these unset and the form falls back to opening the visitor's mail client.
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
